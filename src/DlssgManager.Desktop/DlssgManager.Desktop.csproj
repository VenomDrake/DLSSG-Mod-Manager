<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>DLSSGModManager</AssemblyName>
    <Product>DLSSG Mod Manager</Product>
    <Description>Independent manager for DLSSG for SM86, Apex Neural Rendering and OptiScaler</Description>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/app.ico</ApplicationIcon>
  </PropertyGroup>
  <PropertyGroup Condition="'$(LocalUiPreview)' == 'true'">
    <DefineConstants>$(DefineConstants);LOCAL_UI_PREVIEW</DefineConstants>
    <AssemblyName>DLSSGModManager.UI.Preview</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\DlssgManager.Core\DlssgManager.Core.csproj" />
    <EmbeddedResource Include="Locales\*.json" />
    <Resource Include="Assets\app.png" />
    <Resource Include="Assets\app.ico" />
    <EmbeddedResource Include="..\..\docs\USER_GUIDE.md" LogicalName="Guide.en.md" WithCulture="false" />
    <EmbeddedResource Include="..\..\docs\i18n\USER_GUIDE.*.md" LogicalName="Guide.%(Filename)%(Extension)" WithCulture="false" />
    <Resource Include="..\..\docs\screenshot.png" Link="TutorialImages\screenshot.png" />
    <Resource Include="..\..\docs\settings-sm86.png" Link="TutorialImages\settings-sm86.png" />
    <Resource Include="..\..\docs\settings-anr.png" Link="TutorialImages\settings-anr.png" />
    <Resource Include="..\..\docs\settings-optiscaler.png" Link="TutorialImages\settings-optiscaler.png" />
  </ItemGroup>
</Project>
