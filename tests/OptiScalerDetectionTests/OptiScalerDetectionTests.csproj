<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable></PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/DlssgManager.Core/DlssgManager.Core.csproj" />
    <ProjectReference Include="../Fixtures/DlssgRuntime/DlssgRuntime.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <Target Name="CopyInertFixture" AfterTargets="Build">
    <MSBuild Projects="../Fixtures/DlssgRuntime/DlssgRuntime.csproj" Targets="GetTargetPath" Properties="Configuration=$(Configuration)"><Output TaskParameter="TargetOutputs" ItemName="InertFixture" /></MSBuild>
